# Supabase — Dashboard → Project Settings → Data API / API Keys
# Copy this file to `.env` and fill in your project's values.
#
# Both values are safe to ship in the client bundle: the anon key only grants
# what your Row Level Security policies allow (see supabase/schema.sql).
# Never put the service_role key here — it bypasses RLS entirely.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
